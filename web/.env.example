# Public Privy app id (Dashboard → App settings). Never put PRIVY_APP_SECRET here.
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional Privy app client id (same Dashboard). Required for some login methods.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Public market data edge (Gamma / CLOB / geo). Same host iOS uses.
NEXT_PUBLIC_PEAK_EDGE_URL=https://edge.peakapp.site

# Peak trading API (browser). Worker on api.peakapp.site allows CORS for
# app.peakapp.site + localhost and path-allowlists web routes. Secrets stay
# on Worker/Railway — browser only sends the Privy JWT.
NEXT_PUBLIC_PEAK_API_URL=https://api.peakapp.site

# Server-side Peak API host for Pages routes that still proxy or SSR-fetch
# (invite, legacy /api/peak/*). Must be Worker-fronted api.peakapp.site —
# never *.up.railway.app (skips region / edge-secret stamps).
PEAK_API_URL=https://api.peakapp.site

# Shared with the Peak edge Worker (`PEAK_WEB_PROXY_SECRET`). Only needed if
# something still uses the Pages `/api/peak/*` proxy (browser country claim).
# Direct browser → api.* uses the real client CF country instead.
# PEAK_WEB_PROXY_SECRET=
