# Public Privy app id (Dashboard → App settings). Never put PRIVY_APP_SECRET here.
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional Privy app client id (same Dashboard). Required for some login methods.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Public market data edge (Gamma / CLOB / geo). Same host iOS uses.
NEXT_PUBLIC_PEAK_EDGE_URL=https://edge.peakapp.site

# Peak trading API. Browser never calls this directly — the Next route at
# /api/peak/* proxies so we do not need CORS_ORIGINS on Railway for local/web.
# Server-side only (no NEXT_PUBLIC_) so the origin stays out of the client bundle.
PEAK_API_URL=https://api.peakapp.site

# Shared with the Peak edge Worker (`PEAK_WEB_PROXY_SECRET`). When set on both
# Pages and the Worker, `/api/peak/*` forwards the browser's CF country so the
# region gate sees the trader, not the Pages colo. Generate a long random value;
# never commit the real secret.
# PEAK_WEB_PROXY_SECRET=
