# Peak trading API — copy to .env and fill in. NEVER commit .env.
PORT=8080

# --- Privy (recommended multi-user path) ---
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional later:
# PRIVY_APP_CLIENT_ID=   # iOS only; not required on server

# --- Polymarket Builder (add when ready for live Deposit Wallet + orders) ---
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=
# Optional builder attribution code (bytes32 hex: 0x + 64 hex)
POLY_BUILDER_CODE=
POLYGON_RPC_URL=

# --- Relayer (gasless deploy / approvals — add with Builder) ---
# From polymarket.com → Settings → API Keys → Relayer API Keys
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=
# Optional override (default https://relayer-v2.polymarket.com/)
# POLYMARKET_RELAYER_URL=

# Privy wallet authorization private key (server-side wallet RPC / signMessage).
# Required when Privy policies / "Require signed requests" demand an authorization key.
# Get it: Privy Dashboard → your app → Wallets → Authorization keys → New key
#   (copy the Private key once; Privy cannot recover it).
# Docs: https://docs.privy.io/controls/authorization-keys/keys/create/key
# Dashboard: https://dashboard.privy.io/apps?page=authorization-keys
# Leave unset only if your Privy app does not require authorization signatures yet.
# PEAK_PRIVY_AUTH_KEY=

# Optional durable session file path (default backend/.sessions.json)
# Mount a volume in production so sessions survive restarts.
# PEAK_SESSION_STORE=

# Support contact is now hardcoded on the static legal pages (website/legal/*)
# as support@peakapp.site. PEAK_SUPPORT_EMAIL is unused (legal HTML no longer
# renders from this API). Provision MX/mailbox for that address when ready.

# --- Production hardening ---
# Comma-separated browser origins for CORS allow-list.
# Empty (default) = CORS disabled — correct for the iOS app (no Origin header).
# When the HTTPS API is live and a browser admin/tool needs access, set e.g.:
#   CORS_ORIGINS=https://your-admin.example.com
# Local browser tooling only (optional):
#   CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Wildcards (*) and non-local http:// origins are rejected. Prefer https:// only in production.
# CORS_ORIGINS=
# Behind Fly/Railway/Render reverse proxies (recommended in production):
# TRUST_PROXY=1
# Rate limit (per IP): window ms + max requests (health endpoints are skipped)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=120

# --- Production checklist (Railway / Fly / Render) ---
# Required for Privy multi-user: PRIVY_APP_ID, PRIVY_APP_SECRET
# Required for live Deposit Wallet + orders: POLYMARKET_BUILDER_* + RELAYER_*
# Often required once Builder is on: PEAK_PRIVY_AUTH_KEY (Privy wallet authorization private key)
# Recommended: TRUST_PROXY=1, PEAK_SESSION_STORE on a persistent volume
# Optional: CORS_ORIGINS (leave empty for iOS-only), POLY_BUILDER_CODE
# Legacy optional: APP_TOKEN + PRIVATE_KEY + FUNDER_ADDRESS
# Confirm after deploy: GET /health → privy/builder/relayer/privyAuthKey as expected

# --- Legacy one-wallet proxy (optional local testing) ---
# Shared secret the iOS app sends as Authorization: Bearer <APP_TOKEN>.
# Must also be set on the Fly/Railway/Render host if you use legacy mode there.
# Generate: openssl rand -hex 32
APP_TOKEN=
# EOA private key that controls the funder (0x + 64 hex). Never commit this.
PRIVATE_KEY=
# Address holding pUSD (deposit wallet / proxy / Safe / EOA).
FUNDER_ADDRESS=
# 0=EOA, 1=Proxy, 2=Safe, 3=POLY_1271 deposit wallet (recommended for new accounts)
SIGNATURE_TYPE=3
# Optional — leave blank to auto-derive via createOrDeriveApiKey()
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=
