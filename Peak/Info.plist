<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Peak</string>
	<key>PRIVY_APP_ID</key>
	<string></string>
	<key>PRIVY_APP_CLIENT_ID</key>
	<string></string>
	<!-- Default trading API for Debug + Release. Leave empty only for local-only Debug (then 127.0.0.1:8080). -->
	<key>PEAK_BACKEND_URL</key>
	<string>https://peak-api-production-60b6.up.railway.app</string>
	<!-- After deploy, set to https://YOUR_HOST/legal/privacy (same origin as API). Leave empty for local Debug. -->
	<key>PEAK_PRIVACY_URL</key>
	<string>https://peak-api-production-60b6.up.railway.app/legal/privacy</string>
	<!-- After deploy, set to https://YOUR_HOST/legal/terms -->
	<key>PEAK_TERMS_URL</key>
	<string>https://peak-api-production-60b6.up.railway.app/legal/terms</string>
	<!-- After deploy, set to https://YOUR_HOST/legal/support -->
	<key>PEAK_SUPPORT_URL</key>
	<string>https://peak-api-production-60b6.up.railway.app/legal/support</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.pranay.peak.privy</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>peak</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>metamask</string>
		<string>cbwallet</string>
		<string>rainbow</string>
		<string>trust</string>
		<string>phantom</string>
		<string>zerion</string>
		<string>safe</string>
		<string>argent</string>
		<string>wc</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>polymarket.com</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<false/>
				<key>NSExceptionRequiresForwardSecrecy</key>
				<true/>
				<key>NSExceptionMinimumTLSVersion</key>
				<string>TLSv1.2</string>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
