<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Peak</string>
	<key>PRIVY_APP_ID</key>
	<string></string>
	<key>PRIVY_APP_CLIENT_ID</key>
	<string></string>
	<!-- Default trading API for Debug + Release. Leave empty only for local-only Debug (then 127.0.0.1:8080). -->
	<key>PEAK_EDGE_URL</key>
	<string>https://edge.peakapp.site</string>
	<key>PEAK_BACKEND_URL</key>
	<string>https://api.peakapp.site</string>
	<!-- Legal pages live on Cloudflare Pages (peak-website-88n.pages.dev), not
	     the trading API — so a copy fix doesn't require redeploying the backend
	     that also places live orders. Temporarily use the pages.dev origin
	     while apex peakapp.site SSL returns Cloudflare 525; api.peakapp.site
	     /legal/* 301-redirects here for anything that cached the old address.
	     After Cloudflare custom-domain SSL is fixed, switch these (and
	     backend/legalPages.mjs WEBSITE_ORIGIN) back to https://peakapp.site. -->
	<key>PEAK_PRIVACY_URL</key>
	<string>https://peak-website-88n.pages.dev/legal/privacy</string>
	<key>PEAK_TERMS_URL</key>
	<string>https://peak-website-88n.pages.dev/legal/terms</string>
	<key>PEAK_SUPPORT_URL</key>
	<string>https://peak-website-88n.pages.dev/legal/support</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.pranay.peak.privy</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>peak</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>metamask</string>
		<string>cbwallet</string>
		<string>rainbow</string>
		<string>trust</string>
		<string>phantom</string>
		<string>zerion</string>
		<string>safe</string>
		<string>argent</string>
		<string>wc</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>polymarket.com</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<false/>
				<key>NSExceptionRequiresForwardSecrecy</key>
				<true/>
				<key>NSExceptionMinimumTLSVersion</key>
				<string>TLSv1.2</string>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
